# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY src/Paperless.Domain/Paperless.Domain.csproj src/Paperless.Domain/
COPY src/Paperless.Application/Paperless.Application.csproj src/Paperless.Application/
COPY src/Paperless.Infrastructure/Paperless.Infrastructure.csproj src/Paperless.Infrastructure/
COPY src/Paperless.REST/Paperless.REST.csproj src/Paperless.REST/
RUN dotnet restore src/Paperless.REST/Paperless.REST.csproj

COPY src/Paperless.Domain/ src/Paperless.Domain/
COPY src/Paperless.Application/ src/Paperless.Application/
COPY src/Paperless.Infrastructure/ src/Paperless.Infrastructure/
COPY src/Paperless.REST/ src/Paperless.REST/
RUN dotnet publish src/Paperless.REST/Paperless.REST.csproj --no-restore -c Release -o /app/publish

# Runtime Stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081

ENTRYPOINT ["dotnet", "Paperless.REST.dll"]
